{
  "name": "shorts-flow",
  "description": "Watch YouTube Shorts hands-free.",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:lifecycle": "vitest run --project lifecycle",
    "test:browser": "vitest run --project browser",
    "icons": "bun scripts/icons.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}
